{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lxe-photography",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lxephotography.com",
      "custom_domain": true
    },
    {
      "pattern": "www.lxephotography.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }

  // To enable direct website inquiry delivery after onboarding
  // lxephotography.com in Cloudflare Email Service, add:
  //
  // "send_email": [
  //   {
  //     "name": "EMAIL",
  //     "destination_address": "hello@lxephotography.com",
  //     "allowed_sender_addresses": ["website@lxephotography.com"]
  //   }
  // ]
}
