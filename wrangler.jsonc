{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lxe-photography",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lxephotography.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
