{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lxe-photography",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "lxephotography.com",
      "custom_domain": true
    },
    {
      "pattern": "www.lxephotography.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "lynnlexus421@gmail.com"
    }
  ],
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  }
}
